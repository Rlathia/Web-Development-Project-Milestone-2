{{>header}}

{{>navigation}}
<div class="row">
  <div class="leftcolumn">
    <div class="card">
      <h2>Category of Income/Expense</h2>
      <table>
        <tr>
          <th></th>
          <th></th>
          <th></th>
        </tr>
        {{#categories}}
        <tr>
          <td>{{name}}</td>
          <td><a class="fas fa-edit" href="/categories/updateform/{{rowid}}"></a></td>
          <td><a class="fas fa-trash-alt" href="/categories/delete/{{rowid}}"></a></td>
        </tr>
        {{/categories}}
      </table>
      <p><a href="/addcategoryform">Add Category</a>
      {{#addcategory}}
        <form name="AddCategoryForm" id="AddCategoryForm" class="categoryform" action="categories/addcategory">
          <label for="name">Category Name</label>
          <input type="text" name="name" class="category_name"> <br />
          <input type="submit" id="add_category"/>
        </form>
        <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <symbol id="check-circle-fill" fill="currentColor" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </symbol>
            <symbol id="info-fill" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
            </symbol>
            <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </symbol>
          </svg>
          <div id="output" class="alert d-flex align-items-center"></div>
      {{/addcategory}}
      {{#updatecategory}}
        <form name="EditCategoryForm" id="EditCategoryForm" class="categoryform" action="/categories/updatecategory/{{updateid}}">
          <label for="name">Category Name</label>
          <input type="text" class="category_name" value="{{formdata.name}}" name="name"> <br />
          <input type="submit" id="edit_category"/>
        </form>
        <div id="output" class="alert d-flex align-items-center"></div>
      {{/updatecategory}}
      </div>
  </div>

</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
<script>
console.log("This script runs when the template is rendered.");
  $(document).ready(function() {

    console.log("This script runs when the template is rendered.");
    function ValidateCategoryForm()
    {
      let category_name = $(".category_name").val();
      let category_error = [];
      let was_errors = false;

      if (category_name.length > 50 || category_name == '' || category_name.search(/[a-zA-Z]/) < 0)
      {
        category_error.push("Category name must contain atleast one alphabet");
        was_errors = true;
        $("#category_name").addClass("is-invalid");
        $("#category_name").removeClass("is-valid");
      }
      else 
      {
        $("#category_name").addClass("is-valid");
        $("#category_name").removeClass("is-invalid");
      }

      if (was_errors)
      {
        $("#output").removeClass("alert-success")
        $("#output").addClass("alert-danger");
        let error_list = "<svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:"><use xlink:href="#exclamation-triangle-fill"/></svg> <ul>";
        for (let i = 0; i < category_error.length; i++)
        {
          error_list += "<li>" + category_error[i] + "</li>";
        }
        error_list += "</ul>";
        $("#output").html(error_list);
      }
      else 
      {
        $("#output").removeClass("alert-danger")
        $("#output").addClass("alert-success");
        let success_list = '';
        success_list += "<p><strong>Added successfully!</strong></p>";
        $("#output").html(success_list);
      } 
      event.preventDefault();
    }
    $("#add_category").click(ValidateCategoryForm);
    $("#edit_category").click(ValidateCategoryForm);
  });
</script>