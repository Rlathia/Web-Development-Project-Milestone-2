<!DOCTYPE html>
<html>
<head>
  <title>Daily Expense Manager</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <style>

    body {
      font-family: Arial;
      padding: 10px;
      background: #f1f1f1;
    }

    /* Header/Blog Title */
    .header {
      padding: 30px;
      text-align: center;
      background: white;
    }

    .header h1 {
      font-size: 50px;
    }

    nav a:hover, .active{
      font-weight:bold;
    }

    /* Style the top navigation bar */
    .topnav {
      overflow: hidden;
      background-color: #333;
    }

    /* Style the topnav links */
    .topnav a {
      float: left;
      display: block;
      color: #f2f2f2;
      text-align: center;
      padding: 14px 16px;
      text-decoration: none;
    }

    /* Change color on hover */
    .topnav a:hover {
      background-color: #ddd;
      color: black;
    }

    #transactionType{
      display: none;
    }

    /* Style the transaction (income/expense) navigation bar */
    .transnav {
      background-color: #333;
      display: inline;
      float: left;
    }

    /* Style the transaction nav links */
    .transnav a {
      float: left;
      display: flex;
      color: #f2f2f2;
      text-align: center;
      padding: 14px 16px;
      text-decoration: none;
      width: 50%;
      flex-direction: column;
    }

    /* Change color on hover */
    .transnav a:hover {
      background-color: #ddd;
      color: black;
    }

    button{
      border-radius: 5px;
      padding: 5px;
    }

    #inc-exp{
      margin: 25px 0px;
      padding: 0px 0px;
    }

    #save{
        margin: 10px 20px 10px 40px;
    }
    #reset{
        margin: 10px 0px 10px 20px;
    }

    /* Class for currently selected navigation item  */
    .curnav {
      background-color: #777;
    }

    /* Create two unequal columns that floats next to each other */
    /* Left column */
    .leftcolumn {
      float: left;
      width: 75%;
    }

    /* Right column */
    .rightcolumn {
      float: left;
      width: 25%;
      background-color: #f1f1f1;
      padding-left: 20px;
    }

    /* Fake image */
    .moneyimg {
      background-color: #aaa;
      width: 100%;
      padding: 20px;
    }

    /* Add a card effect for articles */
    .card {
      background-color: white;
      padding: 20px;
      margin-top: 20px;
    }

    /* Clear floats after the columns */
    .row:after {
      content: "";
      display: table;
      clear: both;
    }


    /* Responsive layout - when the screen is less than 800px wide, make the two columns stack on top of each other instead of next to each other */
    @media only screen and (max-width: 768px) {
      .leftcolumn, .rightcolumn {
        width: 100%;
        padding: 0;
      }
      .fulltitle {
	      display: none;
      }
      button{
        font-size: 30px;
      }
      .nameTitle{
        font-size: 50px;
      }
    }

    /* Responsive layout - when the screen is less than 400px wide, make the navigation links stack on top of each other instead of next to each other */
    @media only screen and (max-width: 400px) {
      .topnav a {
        float: none;
        width: 100%;
      }
      .transnav a {
        float: none;
        width: 100%;
      }
      .fulltitle {
	      display: none;
      }
      .nameTitle{
        font-size: 50px;
      }
    }
    </style>
  </head>
<body>
  <div class="title">
        <h1><p class="nameTitle">DEM   <span class="fulltitle">Daily Expense Manager</span></p></h1>
  </div>